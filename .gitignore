# Secrets — never commit
.env
.env.*
!.env.example
# Private local notes (real-portal values, extraction write-ups) — never commit
private/
# Native blobs are never part of this plugin
*.so
# .NET build output
bin/
obj/
*.user
# Python bytecode
__pycache__/
# Jellyfin plugin packaging output
*.zip
artifacts/

# runner logs
logs/*.log
logs/.lock
