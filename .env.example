# Portalito — your portal's values.
#
# Copy this file to `.env` and fill in your own values. `.env` is git-ignored and is NEVER committed
# or published; keep every real key, host and account only there.
#
# The plugin itself reads its settings from the Jellyfin config page (Dashboard -> Plugins ->
# Portalito), not from this file. This file is a personal stash of the values you paste into that
# page, so you keep them in one place and out of git. Each variable below matches one field on the
# config page.

# --- Core identity (required) ---
PORTALITO_TRIPLE_DES_KEY_HEX=          # 3DES portal key, hex (32 or 48 chars)
PORTALITO_HOSTS=                       # comma-separated API hosts, primary first (host-a,host-b)
PORTALITO_APP_ID=                      # APK application id (appId / App header)
PORTALITO_APK_VERSION=                 # APK version (apkVersion / appVer / App-Version header)
PORTALITO_DEVICE_SN=                   # device serial for free-tier activation

# --- Portal protocol (advanced) ---
PORTALITO_PORTAL_CODE=                 # portalCode
PORTALITO_API_BASE_PATH=               # API base path on each host, e.g. /api/core/
PORTALITO_PORTAL_APK_VER=              # apkVer header
PORTALITO_PORTAL_SPKG_VER=             # spkgVer header / sysVersion body field
PORTALITO_PORTAL_USER_AGENT=           # User-Agent for the portal API
PORTALITO_CDN_USER_AGENT=              # User-Agent for the streaming CDN
PORTALITO_LOGIN_PASSWORD_SALT=         # salt appended to the password before hashing at login
PORTALITO_SN_TOKEN_SALT=               # derives the device serial when Device SN is blank (MD5(snToken+salt)); blank if the portal returns the serial
PORTALITO_LIVE_COLUMN_CODE=            # recommend-column code that lists the live categories
PORTALITO_ALL_CHANNELS_COLUMN_ID=      # column id whose live listing is every channel (blank if none)
PORTALITO_CATALOGS=                    # VOD catalogs as code:Label pairs, e.g. movies_root:Movies, series_root:Series

# --- Optional device fields (portal accepts empty) ---
PORTALITO_DEVICE_DRM_ID=
PORTALITO_DEVICE_TOKEN=
PORTALITO_DEVICE_RESERVE1=

# --- Account (optional; live TV needs an account, catalog/VOD do not) ---
PORTALITO_ACCOUNT_EMAIL=
PORTALITO_ACCOUNT_PASSWORD=

# --- Content-Auth signing (advanced; the CDN's per-request signature) ---
PORTALITO_CONTENT_AUTH_METHOD=         # sign2_method value
PORTALITO_CONTENT_AUTH_SALT_HEX=       # signing salt, hex bytes appended before hashing
PORTALITO_CONTENT_AUTH_MD5_SCHEDULE=   # optional non-standard MD5 round-1 schedule (16 indices 0-15); blank = standard MD5
PORTALITO_CONTENT_AUTH_MD5_K_OVERRIDES= # optional MD5 K overrides as index:hex pairs; blank = standard MD5

# --- Other (optional) ---
PORTALITO_TMDB_API_KEY=                # TMDB v3 key for synopses/posters (and the Destacado rows below)
# Destacado rows from TMDB lists, ';'-separated: Label | source | key=value ...  (only titles the portal has are shown).
# This is the plugin's default. Importing an EMPTY value clears the field, which switches to the portal's own rows.
PORTALITO_FEATURED_ROWS=Tendencias | trending | window=week; Estrenos en cine | now-playing; Próximamente | upcoming; Películas populares | popular-movies; Series populares | popular-tv; En emisión hoy | airing-today; Anime del momento | discover-tv | country=JP,KR genre=16 pages=3; Películas de anime | discover-movies | country=JP,KR genre=16; Series coreanas | discover-tv | country=KR nogenre=16,10764,10767 minvotes=20 pages=3; Películas mejor valoradas | top-movies; Series mejor valoradas | top-tv
PORTALITO_EPG_TIME_ZONE=               # IANA id, e.g. America/Bogota (blank = server zone)
PORTALITO_PROXY_BASE_URL=              # base URL ffmpeg uses to reach this server (blank = auto)
PORTALITO_SKIP_PORTAL_TLS_VERIFICATION=false  # true only if your portal presents invalid certs
